# Shared by Django and the Chamet Lucky Number logger.
LUCKY28_HOST=127.0.0.1
LUCKY28_PORT=8000
# Optional overrides; defaults follow HOST/PORT and the project root.
# LUCKY28_API_URL=http://127.0.0.1:8000/api/logger
# LUCKY28_LOGGER_TOKEN=your-shared-token
# LUCKY28_DB_PATH=lucky28.db
CHAMET_GAME_URL=https://webapp.chametw.com/partyList
# Join the first available party and open Lucky Number using the saved login.
CHAMET_AUTO_OPEN=true
# Optional selectors if Chamet changes its menu, or to select a preferred party.
# CHAMET_PARTY_SELECTOR=.card
# CHAMET_MENU_SELECTOR=img[alt="game"], img[src*="game_btn"]
# CHAMET_NUMBER_SELECTOR=:text-is("Lucky Number")
CHAMET_PROFILE_DIR=.local/chamet-profile
CHAMET_DATA_DIR=.local/chamet
CHAMET_BROWSER_CHANNEL=chrome
CHAMET_HEADLESS=false
# Mobile emulation runs in the background; the DevTools panel stays closed.
CHAMET_MOBILE=true
CHAMET_DEVTOOLS=false
CHAMET_VIEWPORT_WIDTH=375
CHAMET_VIEWPORT_HEIGHT=667
# Existing Twilio settings may remain in .env for the legacy notification UI.
# The logger bridge returns signals locally and does not send WhatsApp messages.

# Optional initial Telegram defaults. Configure everything in Alerts → Telegram
# & worker; saved UI settings take precedence and require no restart.
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=

# Optional public HTTP(S) origin for links in group absence Telegram messages.
ALERT_PUBLIC_BASE_URL=

# Tip state, settlement history, and local event queue at /tips/.
# Set a new ID only after replaying corrected history or changed thresholds.
TIP_MONITOR_ID=lucky28
